{
  "name": "ruwang-control",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4320",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:control-disposable:guard": "node --test tests/control-disposable-guard.test.mjs",
    "test:control-disposable": "node scripts/control-disposable-check.mjs",
    "test:review-api-disposable": "node scripts/control-disposable-check.mjs --review-api",
    "test:dispatch-disposable": "node scripts/control-disposable-check.mjs --review-api --dispatch",
    "test:evidence-disposable": "node scripts/control-disposable-check.mjs --review-api --dispatch --evidence",
    "test:read-disposable": "node scripts/control-disposable-check.mjs --review-api --dispatch --evidence --read-contract",
    "review:dispatch-cycle": "node scripts/review-dispatch-cycle.mjs",
    "test:runtime": "node scripts/runtime-smoke.mjs --existing-preview",
    "test:auth-integration": "node scripts/auth-integration.mjs",
    "test:monitoring-integration": "node scripts/monitoring-integration.mjs",
    "db:local:setup": "node scripts/local-postgres.mjs setup",
    "db:local:start": "node scripts/local-postgres.mjs start",
    "db:local:stop": "node scripts/local-postgres.mjs stop",
    "db:local:status": "node scripts/local-postgres.mjs status",
    "db:migrate": "node scripts/migrate.mjs",
    "db:status": "node scripts/migrate.mjs --status",
    "db:verify": "node scripts/verify-database.mjs",
    "operator:bootstrap": "node scripts/bootstrap-operator.mjs",
    "instance:register": "node scripts/register-instance.mjs",
    "check:operational": "npm run db:status && npm run db:verify && npm run test:runtime",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:integrity",
    "check:legacy-preview": "node --check dist/app.js && node scripts/check-assets.mjs",
    "check:integrity": "node scripts/check-integrity.mjs",
    "check:files": "node scripts/check-integrity.mjs --files-only"
  },
  "devDependencies": {
    "braces": "file:vendor/ruwang-braces-depth-guard-3.0.3-ruwang.depth.1.tgz",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "braces": "$braces",
    "source-map-js": "1.2.2"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.43.0",
    "next": "16.3.8",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.0"
  }
}
